# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only formats keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.heic binary
*.ico  binary
*.pdf  binary
*.zip  binary
