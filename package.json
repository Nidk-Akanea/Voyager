{
  "name": "voyager",
  "private": true,
  "description": "Voyager TypeScript workspace: Electron app, React UI, plugin SDK, gRPC client.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "proto:lint": "buf lint",
    "proto:breaking": "buf breaking --against \".git#branch=develop\"",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.10.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
